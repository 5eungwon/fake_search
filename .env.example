# Production: configure both Upstash credentials for durable shared storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set a long random token to protect experiment summaries and CSV exports.
PMF_ADMIN_TOKEN=
# Optional for a single-process, self-hosted server with a persistent volume.
# Development defaults to .data/experiment.json (never committed).
# PMF_DATA_DIR=/absolute/path/to/persistent-data
